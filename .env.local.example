# Copiá este archivo a ".env.local" (sin el ".example") y completá los valores ahí.
# ".env.local" nunca se sube a git (está en .gitignore) — las credenciales de Neon
# viven solo en tu máquina.

# Connection string CON pooler (la usa la app en cada consulta normal):
# postgresql://usuario:password@ep-xxxx-pooler.región.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=

# Connection string SIN pooler (solo para correr migraciones de Drizzle):
# postgresql://usuario:password@ep-xxxx.región.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_DIRECT=
